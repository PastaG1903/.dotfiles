layout {

    focus-ring {
        active-color   "#67e4c4"
        inactive-color "#112c2a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67e4c4"
        inactive-color "#112c2a"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#112c2a70"
    }

    tab-indicator {
        active-color   "#67e4c4"
        inactive-color "#148568"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67e4c480"
    }
}

recent-windows {
    highlight {
        active-color "#67e4c4"
        urgent-color "#fd4663"
    }
}

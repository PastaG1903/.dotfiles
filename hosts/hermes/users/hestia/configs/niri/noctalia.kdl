layout {

    focus-ring {
        active-color   "#51c0fb"
        inactive-color "#03273a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#51c0fb"
        inactive-color "#03273a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#51c0fb"
        inactive-color "#036397"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#51c0fb80"
    }
}

recent-windows {
    highlight {
        active-color "#51c0fb"
        urgent-color "#fd4663"
    }
}

layout {

    focus-ring {
        active-color   "#677ee4"
        inactive-color "#11162c"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#677ee4"
        inactive-color "#11162c"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#11162c70"
    }

    tab-indicator {
        active-color   "#677ee4"
        inactive-color "#142885"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#677ee480"
    }
}

recent-windows {
    highlight {
        active-color "#677ee4"
        urgent-color "#fd4663"
    }
}

layout {

    focus-ring {
        active-color   "#5cdbbd"
        inactive-color "#111413"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#5cdbbd"
        inactive-color "#111413"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#5cdbbd"
        inactive-color "#005142"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#5cdbbd80"
    }
}

recent-windows {
    highlight {
        active-color "#5cdbbd"
        urgent-color "#ffb4ab"
    }
}
